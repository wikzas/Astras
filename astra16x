        if type(saved)~="table" or saved.version~=1 or type(saved.options)~="table" or type(saved.binds)~="table" or type(saved.whitelist)~="table" or type(saved.hud)~="table" then error("Invalid preset format") end
        -- Validate the entire payload before changing any live settings.
        local values,bindings,names,positions={},{},{},{}
        for key,value in pairs(saved.options) do
            if type(options[key])=="boolean" then
                if type(value)~="boolean" then error("Invalid toggle: "..key) end;values[key]=value
            elseif numericSettings[key] then
                local n=normalizeSetting(key,value);if not n then error("Invalid value: "..key) end;values[key]=n
            end
        end
        for key,value in pairs(saved.binds) do
            if key=="menu" or toggleFeature[key] then
                if type(value)~="string" or value=="End" or value=="Unknown" then error("Invalid keybind") end
                local valid,keycode=pcall(function()return Enum.KeyCode[value]end)
                if not valid or not keycode then error("Unknown keybind") end;bindings[key]=value
            end
        end
        if not bindings.menu then error("Preset requires a menu key") end
        for _,name in ipairs(saved.whitelist) do
            if type(name)~="string" or #name>32 or not name:match("^[%w_]+$") then error("Invalid whitelist") end
            names[string.lower(name)]=true
        end
        local pinned={}
        if saved.hardTargets~=nil and type(saved.hardTargets)~="table" then error("Invalid hard targets") end
        for _,id in ipairs(saved.hardTargets or {}) do
            if type(id)~="string" or #id>20 or not id:match("^%d+$") then error("Invalid target ID") end
            pinned[id]=true
        end
        for _,key in ipairs({"health","target"}) do
            local pos=saved.hud[key]
            if type(pos)~="table" or type(pos.x)~="number" or type(pos.y)~="number" or pos.x~=pos.x or pos.y~=pos.y or pos.x<0 or pos.x>1 or pos.y<0 or pos.y>1 then error("Invalid HUD position") end
            if key=="health" and math.abs(pos.x-.5)<.00001 and math.abs(pos.y-.66)<.00001 then pos={x=.52,y=.55} end
            positions[key]=pos
        end
        for key,value in pairs(values) do if numericSettings[key] then options[key]=value end end
        for key,value in pairs(values) do
            if type(value)=="boolean" and options[key]~=value and toggleFeature[key] then toggleFeature[key]() end
        end
        keybinds=bindings;env[KEY.."_Binds"]=keybinds
        api.hardTargets.selected=pinned;env[KEY.."_HardTargets"]=pinned
        whitelist=names;env[KEY.."_Whitelist"]=whitelist
        api.hardTargets.refresh(true)
        local sorted={};for name in pairs(names) do sorted[#sorted+1]=name end;table.sort(sorted);whitelistBox.Text=table.concat(sorted,", ")
        hudPosition(selfHUD,positions.health.x,positions.health.y);hudPosition(targetHUD,positions.target.x,positions.target.y)
        for _,refresh in pairs(sliderRefresh) do refresh() end
        refreshBinds();for _,refresh in ipairs(refreshButtons) do refresh() end
        presetName.Text=name;rememberPreset(name)
    end)
    presetStatus(ok and ("Loaded "..name.." · unavailable features stay off") or ("Load failed: "..tostring(err)))
    return ok
end
