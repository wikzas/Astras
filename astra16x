local function reduceEffect(obj)
    if not options.fps or not api.alive then return end
    if obj:IsA("PostEffect") or obj:IsA("ParticleEmitter") or obj:IsA("Trail")
        or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
        reduceProperty(obj, "Enabled", false)
    elseif obj:IsA("BasePart") then
        reduceProperty(obj, "CastShadow", false)
    elseif obj:IsA("Light") then
        reduceProperty(obj, "Shadows", false)
    end
end
local function restoreFPS()
    for obj, properties in pairs(fpsSaved) do
        for key, saved in pairs(properties) do
            pcall(function()
                if obj[key] == saved.applied then obj[key] = saved.old end
            end)
        end
    end
    fpsSaved = setmetatable({}, {__mode="k"})
end
local fpsEpoch = 0
